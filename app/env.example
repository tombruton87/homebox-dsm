# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=7745
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:7745
SSL_PROXY=0                          # 1 behind DSM's reverse proxy with HTTPS
HB_IMAGE=ghcr.io/sysadminsmedia/homebox:0.26.2   # pinned; the window's Updates tab moves it to a newer release
HB_PEPPER=…                          # made at the first start; signs Homebox's API keys
OWNER_EMAIL=you@example.com          # the first account, made at the first start
OWNER_NAME=Your+Name
SIGNUPS=0                            # 1: anyone who can reach Homebox may make an account
HB_REGISTER=false                    # what Homebox is told (true only while the first account is made)
HB_BIND=                             # 127.0.0.1: only while the first account is made
HB_TRUST_PROXY=false                 # true behind DSM's reverse proxy
WARN_DAYS=30                         # a DSM notification this many days before a warranty ends; 0 = never
